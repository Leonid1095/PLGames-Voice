# PLG Voice — Environment Configuration
# Option 1: Run automated setup:  ./setup.sh
# Option 2: Copy and edit manually:
#   cp .env.example .env
#   # Edit values, then generate configs:
#   source .env && envsubst < Revolt.toml.template > Revolt.toml
#   source .env && export EXTERNAL_IP=YOUR_IP && envsubst < livekit.yml.template > livekit.yml
#   source .env && envsubst < ingress.yml.template > ingress.yml
#   source .env && envsubst < egress.yml.template > egress.yml
#   source .env && envsubst < .env.web.template > .env.web

# Host (domain without https://)
PLG_VOICE_HOST=plgames-voice.ru

# MongoDB
MONGO_USER=plgadmin
MONGO_PASS=changeme_mongo_password

# Redis
REDIS_PASSWORD=changeme_redis_password

# RabbitMQ
RABBIT_USER=rabbituser
RABBIT_PASS=changeme_rabbit_password

# MinIO (S3-compatible storage)
MINIO_USER=minioautumn
MINIO_PASS=changeme_minio_password

# LiveKit (voice channels)
LIVEKIT_API_KEY=changeme_livekit_key
LIVEKIT_API_SECRET=changeme_livekit_secret
LIVEKIT_KEY=changeme_livekit_key
LIVEKIT_SECRET=changeme_livekit_secret

# VAPID keys (push notifications)
# Generate: openssl ecparam -genkey -name prime256v1 -noout | openssl ec | base64 -w0
VAPID_PRIVATE_KEY=changeme_vapid_private_base64
VAPID_PUBLIC_KEY=changeme_vapid_public_base64

# File encryption key
# Generate: openssl rand -base64 32
FILES_ENCRYPTION_KEY=changeme_encryption_key_base64

# Message content encryption key (AES-256-GCM)
# Generate: openssl rand -base64 32
MESSAGES_ENCRYPTION_KEY=changeme_messages_encryption_key_base64

# Bot configuration
BOT_TOKEN=changeme_bot_token
API_URL=https://your-domain.example/api
WS_URL=wss://your-domain.example/ws
PUBLIC_URL=https://your-domain.example
SERVER_ID=changeme_server_id
WELCOME_CHANNEL=changeme_welcome_channel_id

# LiveKit (bot/stream service)
LIVEKIT_URL=http://127.0.0.1:7880
LIVEKIT_PUBLIC_WS_URL=wss://your-domain.example/livekit

# GIF picker (Giphy API key — get free key at developers.giphy.com)
# Leave empty to hide the Search tab in the GIF picker
VITE_GIPHY_API_KEY=
