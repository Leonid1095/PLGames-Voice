[submodule "client/packages/client/assets"]
	path = client/packages/client/assets
	url = https://github.com/stoatchat/assets
	# Deliberately not checked out. scripts/copyAssets.mjs symlinks public/assets
	# at this directory when it is non-empty and at scripts/assets_fallback when
	# it is empty — and the fallback is where PLG Voice's actual branding lives.
	# Upstream's web/ has a different wordmark and no og-preview.png, so checking
	# this out swaps the logo for Stoat's and 404s the link preview.
	#
	# It stayed empty by accident until 08aabf11 restored .gitmodules, because
	# `git submodule update --init` simply failed. Now that it works, `update =
	# none` keeps it from being checked out while the other three still are.
	# Overridable with `git submodule update --checkout` if that is ever wanted.
	update = none
[submodule "client/packages/js-lingui-solid"]
	path = client/packages/js-lingui-solid
	url = https://github.com/stoatchat/javascript-lingui-solid
[submodule "client/packages/solid-livekit-components"]
	path = client/packages/solid-livekit-components
	# Our fork, same arrangement as stoat.js below: the pinned commit carries
	# the PLG Voice rebrand, which upstream has no reason to take. Kept on a
	# plg-voice branch so the fork's main stays a clean mirror of upstream.
	url = https://github.com/Leonid1095/javascript-solid-livekit-components
	branch = plg-voice
[submodule "client/packages/stoat.js"]
	path = client/packages/stoat.js
	# Our fork: the pinned commit carries 12 changes that are not upstream
	# (rich activity, forum channels, EventClient timeouts, uploadFile error
	# handling, the PLG Voice rebrand). They live on the plg-voice branch;
	# the fork's main stays a clean mirror of upstream so it can still be
	# merged from. Upstream remains available as the `upstream` remote.
	url = https://github.com/Leonid1095/javascript-client-sdk
	branch = plg-voice
