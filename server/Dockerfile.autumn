# Local build of the file server.
#
# autumn used to run the prebuilt ghcr.io/stoatchat/file-server:latest. That
# image carries the JPEG XL decoder that every image upload is fed through
# (crates/services/autumn/src/metadata.rs:54), and its copy is pinned to
# jxl-oxide 0.12.5 / jxl-modular 0.11.2 — the versions with GHSA-66m8-c62j-h6v5
# and GHSA-2v8p-fqpx-2q3w open against them. Patching our own Cargo.toml could
# not reach production while the service ran someone else's binary.
#
# ghcr.io is also unreachable from this host (the proxy has no vhost for it), so
# the image could not have been refreshed even if upstream had published a fix.
#
# The build stage is Dockerfile.api's verbatim — it already compiles the whole
# workspace and revolt-autumn falls out of it; only the binary that gets copied
# out differs. The bundle stage mirrors crates/services/autumn/Dockerfile
# (upstream's own), so the runtime contract is unchanged: distroless/cc,
# nonroot (65532:65532), workdir /home/nonroot, static ffmpeg/ffprobe on PATH.

# Build Stage
FROM rust:1.92.0-slim-bookworm AS builder
USER 0:0
WORKDIR /home/rust/src

# Install build requirements
RUN apt-get update && \
    apt-get install -y \
    make \
    pkg-config \
    libssl-dev
COPY scripts/build-image-layer.sh /tmp/

# Build all dependencies
COPY Cargo.toml Cargo.lock ./
COPY crates/bonfire/Cargo.toml ./crates/bonfire/
COPY crates/delta/Cargo.toml ./crates/delta/
COPY crates/core/config/Cargo.toml ./crates/core/config/
COPY crates/core/database/Cargo.toml ./crates/core/database/
COPY crates/core/files/Cargo.toml ./crates/core/files/
COPY crates/core/models/Cargo.toml ./crates/core/models/
COPY crates/core/parser/Cargo.toml ./crates/core/parser/
COPY crates/core/permissions/Cargo.toml ./crates/core/permissions/
COPY crates/core/presence/Cargo.toml ./crates/core/presence/
COPY crates/core/result/Cargo.toml ./crates/core/result/
COPY crates/core/coalesced/Cargo.toml ./crates/core/coalesced/
COPY crates/core/ratelimits/Cargo.toml ./crates/core/ratelimits/
COPY crates/services/autumn/Cargo.toml ./crates/services/autumn/
COPY crates/services/january/Cargo.toml ./crates/services/january/
COPY crates/daemons/crond/Cargo.toml ./crates/daemons/crond/
COPY crates/daemons/pushd/Cargo.toml ./crates/daemons/pushd/
COPY crates/daemons/voice-ingress/Cargo.toml ./crates/daemons/voice-ingress/
RUN sh /tmp/build-image-layer.sh deps

# Build all apps
COPY crates ./crates
RUN sh /tmp/build-image-layer.sh apps

# Bundle Stage
FROM debian:12 AS debian

FROM gcr.io/distroless/cc-debian12:nonroot
COPY --from=builder /home/rust/src/target/release/revolt-autumn ./
COPY --from=mwader/static-ffmpeg:7.0.2 /ffmpeg /usr/local/bin/
COPY --from=mwader/static-ffmpeg:7.0.2 /ffprobe /usr/local/bin/
# autumn shells out to uname; distroless/cc has no coreutils.
COPY --from=debian /usr/bin/uname /usr/bin/uname

EXPOSE 14704
USER nonroot
CMD ["./revolt-autumn"]
