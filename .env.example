# PLG Voice — пример конфигурации окружения
# Скопируйте в .env и заполните реальными значениями:
#   cp .env.example .env
#
# Затем сгенерируйте Revolt.toml:
#   ./setup-config.sh
# Или используйте generate_config.sh для полной генерации с нуля.

# Хост (домен без https://)
PLG_VOICE_HOST=plgames-voice.ru

# MongoDB
MONGO_USER=stoatadmin
MONGO_PASS=changeme_mongo_password

# RabbitMQ
RABBIT_USER=rabbituser
RABBIT_PASS=changeme_rabbit_password

# MinIO (S3-compatible storage)
MINIO_USER=minioautumn
MINIO_PASS=changeme_minio_password

# VAPID ключи (для push-уведомлений)
# Сгенерировать: openssl ecparam -genkey -name prime256v1 -noout -out vapid_private.pem
VAPID_PRIVATE_KEY=changeme_vapid_private_base64
VAPID_PUBLIC_KEY=changeme_vapid_public_base64

# Ключ шифрования файлов
# Сгенерировать: openssl rand -base64 32
FILES_ENCRYPTION_KEY=changeme_encryption_key_base64

# LiveKit (голосовые каналы)
LIVEKIT_KEY=changeme_livekit_key
LIVEKIT_SECRET=changeme_livekit_secret
