:80 {
	# Security headers live in plgvoice.conf, not here.
	#
	# Caddy binds 127.0.0.1:8091 and is only ever reached through nginx, while
	# nginx also serves /whip and /stream/ without passing through Caddy — so
	# nginx is the one hop that covers every request and is the right owner.
	# Setting the same headers in both put two copies on every response, with
	# X-XSS-Protection contradicting itself (0 from here, "1; mode=block" from
	# the stale nginx config that had never been deployed).
	#
	# -Server stays: that is Caddy stripping its own banner, which nginx cannot
	# do for an upstream response.
	header {
		-Server
	}

	route /api* {
		uri strip_prefix /api
		reverse_proxy http://api:14702 {
			header_down Location "^/" "/api/"
		}
	}

	route /ws {
		uri strip_prefix /ws
		reverse_proxy http://events:14703 {
			header_down Location "^/" "/ws/"
			flush_interval -1
			transport http {
				keepalive off
				read_buffer 8192
			}
		}
	}

	route /autumn* {
		uri strip_prefix /autumn
		reverse_proxy http://autumn:14704 {
			header_down Location "^/" "/autumn/"
		}
	}

	route /january* {
		uri strip_prefix /january
		reverse_proxy http://january:14705 {
			header_down Location "^/" "/january/"
		}
	}

	route /livekit* {
		uri strip_prefix /livekit
		reverse_proxy http://livekit:7880 {
			header_down Location "^/" "/livekit/"
			flush_interval -1
			transport http {
				keepalive off
				read_buffer 8192
			}
		}
	}

	route /ingress* {
		uri strip_prefix /ingress
		reverse_proxy http://voice-ingress:8500 {
			header_down Location "^/" "/ingress/"
		}
	}

	# Allow .well-known for PWA/TWA verification
	route /.well-known/* {
		reverse_proxy http://web:5000
	}

	# Block access to hidden files (.git, .env, etc.)
	@hidden {
		path_regexp hidden \/\.
		not path /.well-known/*
	}
	respond @hidden 404

	reverse_proxy http://web:5000
}
