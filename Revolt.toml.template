[database]
mongodb = "mongodb://${MONGO_USER}:${MONGO_PASS}@database:27017/revolt?authSource=admin"
redis = "redis://redis/"

[hosts]
app = "https://${PLG_VOICE_HOST}"
api = "https://${PLG_VOICE_HOST}/api"
events = "wss://${PLG_VOICE_HOST}/ws"
autumn = "https://${PLG_VOICE_HOST}/autumn"
january = "https://${PLG_VOICE_HOST}/january"

[hosts.livekit]
worldwide = "wss://${PLG_VOICE_HOST}/livekit"

[pushd.vapid]
private_key = "${VAPID_PRIVATE_KEY}"
public_key = "${VAPID_PUBLIC_KEY}"

[files]
encryption_key = "${FILES_ENCRYPTION_KEY}"

[api.livekit.nodes.worldwide]
url = "http://livekit:7880"
lat = 0.0
lon = 0.0
key = "${LIVEKIT_KEY}"
secret = "${LIVEKIT_SECRET}"
